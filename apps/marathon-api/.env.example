# App
NODE_ENV=development
PORT=3000
APP_VERSION=0.0.1
COMMIT_SHA=
WEB_APP_URL=http://localhost:4200

# Auth
JWT_SECRET_KEY=
ADMIN_SECRET_KEY=change-me

# Database
MARATHON_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/marathon

# Super admin bootstrap
MARATHON_SUPER_ADMIN_PHONE=233200000000

# Payments (Mojo collection)
PAYMENT_ENV=dev
PAYMENT_STALE_THRESHOLD_HOURS=24
PAYMENT_TRUST_ID=win-pc-2f8a1b4e
MOJO_APP_ID=
MOJO_APP_KEY=

# Hubtel SMS
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_FROM=MojoPay

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address must match SMTP_USER unless the relay grants send-as rights.
# Display name is unrestricted. Empty falls back to SMTP_USER.
EMAIL_FROM="Akuapem Ridge Marathon <contribute@mojo-pay.com>"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0
