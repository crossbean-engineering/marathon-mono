model Merchandise {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  packages    Package[]
  collections ParticipantMerchandise[]

  @@map("merchandise")
}

model Package {
  id        String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name      String   @unique
  price     Int // pesewas
  benefits  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchandise  Merchandise[]
  prizes       Prize[]
  participants Participant[]
  coupons      Coupon[]

  @@map("packages")
}

model Coupon {
  id         String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  code       String   @unique
  percentOff Int      @map("percent_off") // 1–100 (100 = free)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  packages Package[] // the package(s) this coupon applies to (>= 1)
  payments Payment[] // redemptions, for reporting

  @@map("coupons")
}

model Prize {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name        String
  amount      Int? // pesewas
  position    Int?
  description String?
  packageId   String   @map("package_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("prizes")
}

enum AddOnType {
  accommodation
  transport
}

// Optional extras bought alongside a race package — the Weekend Package
// (accommodation, return transport). Priced per person. A participant takes at
// most one add-on of each type.
model AddOn {
  id          String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  type        AddOnType
  name        String
  provider    String? // e.g. the hotel / apartment name
  description String?
  occupancy   Int? // accommodation only: people sharing the room
  price       Int // pesewas, per person
  capacity    Int? // max bookings; null = unlimited
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  bookings ParticipantAddOn[]

  @@index([type])
  @@map("add_ons")
}
